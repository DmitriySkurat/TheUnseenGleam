MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 45d965b609d06c44599f59bc71c36117, type: 3}
  m_Name: OldManDialog
  m_EditorClassIdentifier: Assembly-CSharp::DialogData
  playerName: "\u041B\u0438\u0430\u043D"
  playerSprite: {fileID: 3393699401562451319, guid: 0bad411d107959f4bb7c6a514bfb2ab5, type: 3}
  npcSprite: {fileID: 7599611432461533966, guid: 5755b7d3097ea4d4eaadcb50dba24e8a, type: 3}
  lines:
  - speaker: 0
    text: "\u0413\u0434\u0435 \u044F?.. \u0427\u0442\u043E \u044D\u0442\u043E \u0437\u0430
      \u043C\u0435\u0441\u0442\u043E?"
  - speaker: 1
    text: "\u0422\u0438\u0448\u0435. \u041D\u0435 \u043A\u0440\u0438\u0447\u0438.
      \u041E\u043D\u0438 \u043C\u043E\u0433\u0443\u0442 \u0443\u0441\u043B\u044B\u0448\u0430\u0442\u044C."
  - speaker: 0
    text: "\u041A\u0442\u043E \u041E\u043D\u0438?"
  - speaker: 1
    text: "\u0422\u0435, \u043A\u0442\u043E \u0434\u0435\u0440\u0436\u0438\u0442
      \u043D\u0430\u0441 \u0437\u0434\u0435\u0441\u044C. \u042D\u0442\u043E \u0448\u0430\u0445\u0442\u044B
      \u043F\u043E\u0434 \u0441\u0442\u0430\u0440\u043E\u0439 \u043A\u0440\u0435\u043F\u043E\u0441\u0442\u044C\u044E.
      \u041D\u0438\u043A\u0442\u043E \u043D\u0435 \u043F\u043E\u043F\u0430\u0434\u0430\u0435\u0442
      \u0441\u044E\u0434\u0430 \u043F\u043E \u0441\u0432\u043E\u0435\u0439 \u0432\u043E\u043B\u0435."
  - speaker: 0
    text: "\u041C\u043D\u0435 \u043D\u0443\u0436\u043D\u043E \u0432\u044B\u0431\u0440\u0430\u0442\u044C\u0441\u044F
      \u043E\u0442\u0441\u044E\u0434\u0430. \u0422\u044B \u0437\u043D\u0430\u0435\u0448\u044C
      \u0432\u044B\u0445\u043E\u0434?"
  - speaker: 1
    text: "\u041A\u043E\u0433\u0434\u0430-\u0442\u043E \u044F \u0442\u043E\u0436\u0435
      \u0438\u0441\u043A\u0430\u043B \u0435\u0433\u043E. \u0414\u043E\u043B\u0433\u043E
      \u0431\u0440\u043E\u0434\u0438\u043B \u043F\u043E \u0442\u0443\u043D\u043D\u0435\u043B\u044F\u043C
      \u0438 \u043E\u0434\u043D\u0430\u0436\u0434\u044B \u043D\u0430\u0448\u0451\u043B
      \u0441\u0442\u0440\u0430\u043D\u043D\u0443\u044E \u0432\u0435\u0449\u044C \u0441\u0440\u0435\u0434\u0438
      \u0437\u0430\u0432\u0430\u043B\u043E\u0432."
  - speaker: 1
    text: "\u0412\u043E\u0442 \u044D\u0442\u043E \u0437\u0435\u0440\u043A\u0430\u043B\u043E."
  - speaker: 0
    text: "\u041E\u0431\u044B\u0447\u043D\u043E\u0435 \u0437\u0435\u0440\u043A\u0430\u043B\u043E?"
  - speaker: 1
    text: "\u041D\u0435\u0442. \u042F \u0437\u0430\u043C\u0435\u0442\u0438\u043B,
      \u0447\u0442\u043E \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0430, \u0436\u0438\u0432\u0443\u0449\u0438\u0435
      \u0432\u043E \u0442\u044C\u043C\u0435, \u0431\u043E\u044F\u0442\u0441\u044F
      \u0435\u0433\u043E \u0441\u0432\u0435\u0442\u0430. \u041A\u043E\u0433\u0434\u0430
      \u043B\u0443\u0447 \u043A\u0430\u0441\u0430\u0435\u0442\u0441\u044F \u0438\u0445,
      \u043E\u043D\u0438 \u0434\u0438\u0437\u043E\u0440\u0438\u0435\u043D\u0442\u0438\u0440\u0443\u044E\u0442\u0441\u044F.
      \u042D\u0442\u043E \u0437\u0435\u0440\u043A\u0430\u043B\u043E \u0441\u043F\u0430\u0441\u0430\u043B\u043E
      \u043C\u0435\u043D\u044F \u043D\u0435 \u043E\u0434\u0438\u043D \u0440\u0430\u0437."
  - speaker: 0
    text: "\u0417\u043D\u0430\u0447\u0438\u0442, \u043E\u043D\u043E \u043F\u043E\u043C\u043E\u0436\u0435\u0442
      \u043C\u043D\u0435 \u043F\u0440\u043E\u0439\u0442\u0438 \u0447\u0435\u0440\u0435\u0437
      \u0448\u0430\u0445\u0442\u044B?"
  - speaker: 1
    text: "\u0412\u043E\u0437\u043C\u043E\u0436\u043D\u043E. \u041D\u043E \u043F\u0443\u0442\u044C
      \u0432\u0441\u0451 \u0440\u0430\u0432\u043D\u043E \u0431\u0443\u0434\u0435\u0442
      \u043E\u043F\u0430\u0441\u043D\u044B\u043C. \u0421\u0432\u0435\u0442 \u0437\u0430\u0449\u0438\u0442\u0438\u0442
      \u0442\u0435\u0431\u044F \u043D\u0435 \u043E\u0442 \u0432\u0441\u0435\u0433\u043E."
  - speaker: 0
    text: "\u0410 \u043F\u043E\u0447\u0435\u043C\u0443 \u0442\u044B \u0441\u0430\u043C
      \u043D\u0435 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0435\u0448\u044C
      \u0435\u0433\u043E?"
  - speaker: 1
    text: "\u0421\u043B\u0438\u0448\u043A\u043E\u043C \u043F\u043E\u0437\u0434\u043D\u043E
      \u0434\u043B\u044F \u043C\u0435\u043D\u044F. \u0412\u0440\u0435\u043C\u044F,
      \u0447\u0442\u043E \u044F \u043F\u0440\u043E\u0432\u0435\u043B \u0432 \u044D\u0442\u043E\u043C
      \u043F\u043E\u0434\u0437\u0435\u043C\u0435\u043B\u044C\u0435, \u043E\u0442\u043D\u044F\u043B\u043E
      \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0435 \u0441\u0438\u043B\u044B.
      \u042F \u0443\u0436\u0435 \u043D\u0435 \u0441\u043C\u043E\u0433\u0443 \u043F\u0440\u043E\u0439\u0442\u0438
      \u0432\u0435\u0441\u044C \u0442\u043E\u0442 \u043F\u0443\u0442\u044C, \u043A\u043E\u0442\u043E\u0440\u044B\u0439
      \u043F\u0440\u0435\u0434\u0441\u0442\u043E\u0438\u0442 \u0442\u0435\u0431\u0435."
  - speaker: 0
    text: ...
  - speaker: 1
    text: "\u0412\u043E\u0437\u044C\u043C\u0438 \u0437\u0435\u0440\u043A\u0430\u043B\u043E.
      \u0418 \u0435\u0441\u043B\u0438 \u043D\u0430\u0439\u0434\u0451\u0448\u044C
      \u0432\u044B\u0445\u043E\u0434, \u043D\u0435 \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u0439
      \u0442\u044C\u043C\u0435 \u0432\u044B\u0431\u0440\u0430\u0442\u044C\u0441\u044F
      \u0432\u0441\u043B\u0435\u0434 \u0437\u0430 \u0442\u043E\u0431\u043E\u0439."
  - speaker: 0
    text: "\u0421\u043F\u0430\u0441\u0438\u0431\u043E. \u042F \u043F\u043E\u0441\u0442\u0430\u0440\u0430\u044E\u0441\u044C
      \u0432\u044B\u0431\u0440\u0430\u0442\u044C\u0441\u044F \u043E\u0442\u0441\u044E\u0434\u0430."
  - speaker: 1
    text: "\u0422\u043E\u0433\u0434\u0430 \u043D\u0435 \u0442\u0435\u0440\u044F\u0439
      \u0432\u0440\u0435\u043C\u0435\u043D\u0438. \u041F\u043E\u043F\u0440\u043E\u0431\u0443\u0439
      \u0432\u044B\u043A\u0440\u0430\u0441\u0442\u044C \u043A\u043B\u044E\u0447\u0438
      \u043E\u0442 \u043A\u0430\u043C\u0435\u0440\u044B \u0443 \u0441\u0442\u0440\u0430\u0436\u043D\u0438\u043A\u0430."
