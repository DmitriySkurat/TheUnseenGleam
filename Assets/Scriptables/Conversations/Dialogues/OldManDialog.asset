--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 45d965b609d06c44599f59bc71c36117, type: 3}
  m_Name: OldManDialog
  m_EditorClassIdentifier: Assembly-CSharp::DialogData
  playerName: "\u041B\u0438\u0430\u043D"
  playerSprite: {fileID: 3393699401562451319, guid: 0bad411d107959f4bb7c6a514bfb2ab5, type: 3}
  npcSprite: {fileID: 7599611432461533966, guid: 5755b7d3097ea4d4eaadcb50dba24e8a, type: 3}
  lines:
  - speaker: 0
    text: "\u0413\u0434\u0435 \u044F? \u0427\u0442\u043E \u044D\u0442\u043E \u0437\u0430
      \u043C\u0435\u0441\u0442\u043E?"
  - speaker: 1
    text: "\u0422\u0438\u0445\u043E, \u0434\u0438\u0442\u044F... \u042D\u0442\u043E
      \u0442\u044E\u0440\u044C\u043C\u0430. \u0413\u043B\u0443\u0431\u043E\u043A\u043E
      \u043F\u043E\u0434 \u0437\u0435\u043C\u043B\u0451\u0439."
  - speaker: 0
    text: "\u0415\u0441\u0442\u044C \u043B\u0438 \u0432\u044B\u0445\u043E\u0434 \u043E\u0442\u0441\u044E\u0434\u0430?"
  - speaker: 1
    text: "\u041A\u043E\u0433\u0434\u0430-\u0442\u043E \u044F \u043F\u044B\u0442\u0430\u043B\u0441\u044F
      \u0431\u0435\u0436\u0430\u0442\u044C. \u041D\u0430\u0448\u0451\u043B \u043A\u043E\u0435-\u0447\u0442\u043E
      \u0432 \u0442\u0435\u043C\u043D\u043E\u0442\u0435..."
  - speaker: 1
    text: "\u042D\u0442\u043E \u0437\u0435\u0440\u043A\u0430\u043B\u043E. \u042F
      \u0437\u0430\u043C\u0435\u0442\u0438\u043B \u2014 \u0441\u0432\u0435\u0442
      \u0432\u043E\u0437\u0434\u0435\u0439\u0441\u0442\u0432\u0443\u0435\u0442 \u043D\u0430
      \u0441\u0443\u0449\u0435\u0441\u0442\u0432 \u0432 \u0442\u0435\u043C\u043D\u043E\u0442\u0435,
      \u043E\u0442\u043F\u0443\u0433\u0438\u0432\u0430\u0435\u0442 \u0438\u0445."
  - speaker: 0
    text: "\u041E\u043D\u043E \u043F\u043E\u043C\u043E\u0436\u0435\u0442 \u043C\u043D\u0435
      \u0432\u044B\u0431\u0440\u0430\u0442\u044C\u0441\u044F?"
  - speaker: 1
    text: "\u0412\u043E\u0437\u043C\u043E\u0436\u043D\u043E... \u042F \u0441\u043B\u0438\u0448\u043A\u043E\u043C
      \u0441\u043B\u0430\u0431, \u0447\u0442\u043E\u0431\u044B \u043F\u043E\u043A\u0438\u043D\u0443\u0442\u044C
      \u044D\u0442\u043E \u043C\u0435\u0441\u0442\u043E. \u0412\u043E\u0437\u044C\u043C\u0438
      \u0435\u0433\u043E."
