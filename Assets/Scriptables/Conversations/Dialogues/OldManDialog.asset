MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 45d965b609d06c44599f59bc71c36117, type: 3}
  m_Name: OldManDialog
  m_EditorClassIdentifier: Assembly-CSharp::DialogData
  playerName: "Лиан"
  playerSprite: {fileID: 3393699401562451319, guid: 0bad411d107959f4bb7c6a514bfb2ab5,
    type: 3}
  npcSprite: {fileID: 0}
  lines:
  - speaker: 0
    text: "Где я? Что это за
      место?"
  - speaker: 1
    text: "Тихо, дитя... Это
      тюрьма. Глубоко
      под землёй."
  - speaker: 0
    text: "Есть ли выход отсюда?"
  - speaker: 1
    text: "Когда-то я пытался
      бежать. Нашёл кое-что
      в темноте..."
  - speaker: 1
    text: "Это зеркало. Я заметил
      — свет воздействует
      на существ в темноте,
      отпугивает их."
  - speaker: 0
    text: "Оно поможет мне
      выбраться?"
  - speaker: 1
    text: "Возможно... Я слишком
      слаб, чтобы покинуть
      это место. Возьми
      его."
