MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 45d965b609d06c44599f59bc71c36117, type: 3}
  m_Name: GuideNPCCongratsDialog
  m_EditorClassIdentifier: Assembly-CSharp::DialogData
  playerName: "\u041B\u0438\u0430\u043D"
  playerSprite: {fileID: 3393699401562451319, guid: 0bad411d107959f4bb7c6a514bfb2ab5, type: 3}
  npcSprite: {fileID: 7599611432461533966, guid: 5755b7d3097ea4d4eaadcb50dba24e8a, type: 3}
  lines:
  - speaker: 1
    text: "\u041B\u0438\u0430\u043D! \u0422\u044B \u0441\u043F\u0440\u0430\u0432\u0438\u043B\u0430\u0441\u044C!
      \u0412\u0441\u0435 \u043F\u043E\u0434\u0441\u043E\u043B\u043D\u0443\u0445\u0438
      \u0441\u043E\u0431\u0440\u0430\u043D\u044B. \u0421\u043F\u0430\u0441\u0438\u0431\u043E
      \u0442\u0435\u0431\u0435 \u043E\u0442 \u0438\u043C\u0435\u043D\u0438 \u0432\u0441\u0435\u0439
      \u0434\u0435\u0440\u0435\u0432\u043D\u0438."
  - speaker: 0
    text: "\u041D\u0435 \u0441\u0442\u043E\u0438\u0442 \u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u043D\u043E\u0441\u0442\u0438.
      \u042D\u0442\u043E \u043E\u043A\u0430\u0437\u0430\u043B\u043E\u0441\u044C \u043B\u0435\u0433\u0447\u0435,
      \u0447\u0435\u043C \u044F \u043E\u0436\u0438\u0434\u0430\u043B\u0430."
  - speaker: 1
    text: "\u041D\u0435\u0442, \u0442\u044B \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u043E
      \u043D\u0430\u0441 \u0432\u044B\u0440\u0443\u0447\u0438\u043B\u0430. \u0411\u0435\u0437
      \u0442\u0435\u0431\u044F \u043C\u044B \u0431\u044B \u043D\u0435 \u0443\u0441\u043F\u0435\u043B\u0438
      \u0441\u043E\u0431\u0440\u0430\u0442\u044C \u0443\u0440\u043E\u0436\u0430\u0439
      \u0434\u043E \u043D\u0430\u0441\u0442\u0443\u043F\u043B\u0435\u043D\u0438\u044F
      \u043D\u0435\u043F\u043E\u0433\u043E\u0434\u044B."
  - speaker: 0
    text: "\u0420\u0430\u0434\u0430, \u0447\u0442\u043E \u0441\u043C\u043E\u0433\u043B\u0430
      \u043F\u043E\u043C\u043E\u0447\u044C. \u0414\u0443\u043C\u0430\u044E, \u0442\u0435\u043F\u0435\u0440\u044C
      \u043C\u043E\u0436\u043D\u043E \u043D\u0435\u043C\u043D\u043E\u0433\u043E \u043E\u0442\u0434\u043E\u0445\u043D\u0443\u0442\u044C."
  - speaker: 1
    text: "\u041F\u043E\u0434\u043E\u0436\u0434\u0438... \u0427\u0442\u043E \u044D\u0442\u043E
      \u0442\u0430\u043C?"
  - speaker: 0
    text: "\u0413\u0434\u0435?"
  - speaker: 1
    text: "\u041D\u0430 \u043F\u043E\u043B\u0435."
  - speaker: 1
    text: "\u0411\u0435\u0433\u0438! \u0421\u0435\u0439\u0447\u0430\u0441 \u0436\u0435!"
