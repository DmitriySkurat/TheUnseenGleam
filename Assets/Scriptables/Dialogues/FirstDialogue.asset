  playerName: Lian
  playerSprite: {fileID: 3393699401562451319, guid: 0bad411d107959f4bb7c6a514bfb2ab5, type: 3}
  npcSprite: {fileID: 7370158955753839994, guid: 4bd36f1b2d4eb2f44b41ca794f7ccd66, type: 3}
  lines:
  - speaker: 1
    text: "\u041F\u0440\u0438\u0432\u0435\u0442, \u043A\u0430\u043A \u0434\u0435\u043B\u0430?"
  - speaker: 0
    text: "\u0412\u0441\u0451 \u0445\u043E\u0440\u043E\u0448\u043E, \u0442\u044B
      \u043A\u0430\u043A?"
  - speaker: 1
    text: "\u041E\u0442\u043B\u0438\u0447\u043D\u043E, \u0432\u043E\u0442 \u0431\u043B\u0443\u0436\u0434\u0430\u044E
      \u043F\u043E \u043A\u0440\u0435\u043F\u043E\u0441\u0442\u0438"
  - speaker: 0
    text: "\u041E, \u044F \u0442\u043E\u0436\u0435, \u0434\u0430\u0432\u0430\u0439
      \u0431\u043B\u0443\u0436\u0434\u0430\u0442\u044C \u0432\u043C\u0435\u0441\u0442\u0435"
